[project]
name = "{{repository_name}}"
version = "1.0.0"
description = "{{repository_description|replace('"', '\\"')|replace("\n", " ")}}"
packages = []
authors = []

dependencies = [
   "oarepo[s3,rdm]>=14.0.0b1,<15.0.0",
   "oarepo-app[production{% if use_ccmm %},ccmm{% endif %}]>=2.0.1,<3.0.0"
]
requires-python = ">=3.14,<3.15"

[project.entry-points."invenio_assets.webpack"]
i18n = "i18n.webpack:theme"
components = "ui.components.webpack:theme"

[project.entry-points."invenio_i18n.translations"]
translations = "i18n"

[project.entry-points."invenio_db.alembic"]
repository = "common:alembic"

[tool.uv.build-backend]
module-root = ""
module-name = ["common", "i18n", "ui"]

[build-system]
requires = ["uv_build>=0.8.7,<0.9.0"]
build-backend = "uv_build"
