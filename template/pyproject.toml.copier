[project]
name = "{{repository_name}}"
version = "1.0.0"
description = "{{repository_description|replace('"', '\\"')|replace("\n", " ")}}"
packages = []
authors = []

dependencies = [
   "oarepo[s3,rdm]>=14.2.1,<15.0.0",
   # Optional oarepo-app extras that can be added to the list below:
   #   antivirus        - antivirus scanning of uploaded files (oarepo-antivirus)
   #   ark              - ARK persistent identifiers (oarepo-ark)
{%- if not use_ccmm %}
   #   ccmm             - Czech Core Metadata Model based models (ccmm-invenio)
{%- endif %}
   #   llm              - LLM-based metadata checks (oarepo-checks)
   #   oaipmh-harvester - harvesting records from OAI-PMH sources (oarepo-oai-pmh-harvester)
   "oarepo-app[{% if use_ccmm %}ccmm,{% endif %}production]>=8.0.0,<9.0.0",
]
requires-python = ">=3.14,<3.15"

[project.optional-dependencies]
# installed automatically by ./run.sh for local development
dev = [
   "flask-debugtoolbar",
]

[project.entry-points."invenio_assets.webpack"]
i18n = "i18n.webpack:theme"
components = "ui.components.webpack:theme"

[project.entry-points."invenio_db.alembic"]
repository = "common:alembic"

[tool.uv.build-backend]
module-root = ""
module-name = ["common", "i18n", "ui"]

[build-system]
requires = ["uv_build>=0.8.7,<0.9.0"]
build-backend = "uv_build"
